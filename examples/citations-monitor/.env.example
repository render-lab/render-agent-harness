# Local dev: matches the Compose stack at the repo root.
# Run `pnpm db:up` from the repo root before starting the agent.
DATABASE_URL=postgres://harness:harness@127.0.0.1:55432/harness
KV_URL=redis://127.0.0.1:56379

# The agent's reasoning model.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# The "engine being audited." Defaults to OpenAI gpt-5; override
# SEARCH_ENGINE_BASE_URL to point at Perplexity, OpenRouter, etc.
SEARCH_ENGINE_API_KEY=sk-...
SEARCH_ENGINE_MODEL=gpt-5
# SEARCH_ENGINE_BASE_URL=https://openrouter.ai/api/v1
