# Local dev: matches the Compose stack at the repo root.
# Run `pnpm db:up` from the repo root before starting the agent.
DATABASE_URL=postgres://harness:harness@127.0.0.1:5432/harness
KV_URL=redis://127.0.0.1:6379

# The agent's reasoning model.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-7

# Optional: Render MCP for service introspection. Get a workspace API key at
# https://dashboard.render.com/u/settings#api-keys
# RENDER_API_KEY=rnd_...
# RENDER_MCP_URL=https://mcp.render.com/mcp

# HTTP port. Render sets this for you in production; locally we default to 8080.
PORT=8080
