# Local dev: matches the Compose stack at the repo root.
DATABASE_URL=postgres://harness:harness@127.0.0.1:55432/harness
KV_URL=redis://127.0.0.1:56379

# The agent's reasoning model.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# Slack credentials. Get a Bot User OAuth Token (xoxb-...) and Signing Secret
# from your Slack app's "OAuth & Permissions" and "Basic Information" pages.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Worker queue name. Must match between web and worker.
WORKER_QUEUE=support-runs

# HTTP port for the web service.
PORT=8080
