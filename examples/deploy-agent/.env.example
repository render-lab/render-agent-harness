# Local trigger CLI uses these. The Workflow service itself reads its env
# from the Render Dashboard once deployed.

DATABASE_URL=postgres://harness:harness@127.0.0.1:55432/harness
KV_URL=redis://127.0.0.1:56379

# The agent's reasoning model.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# Render workspace API key. Used by both:
#   - The agent's Render MCP connection (to read services, create deploys, etc.)
#   - The trigger CLI's @renderinc/sdk client (to startTask the workflow)
# Get one at https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_...

# Optional: pin a workspace so the agent doesn't have to choose.
# RENDER_WORKSPACE_ID=tea_...
