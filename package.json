{
  "name": "render-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Render-native agent harness. Built on Render primitives (Workflows, Workers, Cron, Postgres, KV, Private Services), provider-agnostic at the model layer, MCP-first for tools.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "dev:citations": "pnpm --filter @render-harness/example-citations-monitor dev"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
