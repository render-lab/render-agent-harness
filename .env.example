# Copy to .env at the repo root for local development. Each example may have
# its own .env that overlays these (see examples/citations-monitor/.env.example).
#
# In production on Render, these come from your service's env vars, not from
# .env files.

# --- Harness primitives -----------------------------------------------------

# Postgres connection. Matches the local Compose stack.
DATABASE_URL=postgres://harness:harness@127.0.0.1:5432/harness

# Key Value (Valkey/Redis). Matches the local Compose stack. Optional in cron
# (the runtime degrades gracefully if unset); required for the worker runtime.
KV_URL=redis://127.0.0.1:6379

# --- Default model client ---------------------------------------------------

# The model your agents use for reasoning. Anthropic SDK is the default
# adapter; see packages/core/src/adapters/openai-compat.ts for OpenRouter,
# Bedrock, Vertex, vLLM, Ollama, etc.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-7

# --- Logging ---------------------------------------------------------------

LOG_LEVEL=info
NODE_ENV=development
