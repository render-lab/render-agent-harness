{
  "name": "@render-harness/cap-granola",
  "version": "0.6.0",
  "description": "Granola.ai meeting-notes capability pack for the Render agent harness. API-key auth + polling primitive for ingesting new meeting notes.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "granola",
    "meeting-notes",
    "transcripts",
    "polling"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Granola (meeting notes)",
      "envHint": "GRANOLA_API_KEY"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@render-harness/core": "workspace:*",
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-granola"
  }
}
