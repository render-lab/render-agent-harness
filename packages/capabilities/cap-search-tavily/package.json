{
  "name": "@render-harness/cap-search-tavily",
  "version": "0.1.4",
  "description": "Tavily AI-search capability pack for the Render agent harness.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "tavily",
    "search",
    "mcp"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Tavily web search",
      "envHint": "TAVILY_API_KEY"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@render-harness/core": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-search-tavily"
  }
}
