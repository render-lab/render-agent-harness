{
  "name": "@render-harness/cap-slack",
  "version": "0.7.0",
  "description": "Slack Events and Web API capability pack for the Render agent harness.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "slack"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Slack",
      "envHint": "SLACK_BOT_TOKEN"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@render-harness/registry": "workspace:*",
    "@slack/web-api": "^7.12.0"
  },
  "devDependencies": {
    "@render-harness/core": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-slack"
  }
}
