{
  "name": "@render-harness/cap-linear",
  "version": "0.8.0",
  "description": "Linear monitoring capability pack for the Render agent harness.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "linear"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Linear",
      "envHint": "LINEAR_API_KEY"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@linear/sdk": "^63.4.0",
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@render-harness/core": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-linear"
  }
}
