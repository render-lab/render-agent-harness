{
  "name": "@render-harness/cap-figma",
  "version": "0.8.1",
  "description": "Figma capability pack for the Render agent harness. First pack with granular per-action OAuth scopes (post-Nov-2025 platform update).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "figma",
    "design",
    "oauth"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Figma",
      "envHint": "FIGMA_OAUTH_CLIENT_ID"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@render-harness/core": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-figma"
  }
}
