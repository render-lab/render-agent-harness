{
  "name": "@render-harness/cap-scrape-firecrawl",
  "version": "0.1.4",
  "description": "Firecrawl scrape capability pack with optional Postgres persistence.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "firecrawl",
    "scrape",
    "mcp"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Firecrawl page scrape",
      "envHint": "FIRECRAWL_API_KEY"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@render-harness/core": "workspace:*",
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
