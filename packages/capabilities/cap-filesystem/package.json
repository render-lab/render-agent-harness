{
  "name": "@render-harness/cap-filesystem",
  "version": "0.7.0",
  "description": "Path-scoped filesystem tools for the Render agent harness. Opt-in per agent; the worker pserv is multi-tenant by default so this is NOT a core builtin.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "render-harness-cap",
    "render-harness",
    "filesystem"
  ],
  "renderHarness": {
    "gallery": {
      "label": "Filesystem (path-scoped fs tools)",
      "envHint": null
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@render-harness/core": "workspace:*",
    "@render-harness/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/capabilities/cap-filesystem"
  }
}
