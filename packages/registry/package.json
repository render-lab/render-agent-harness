{
  "name": "@render-harness/registry",
  "version": "0.5.1",
  "description": "Config registry for the Render agent harness. Schema for render-harness.yaml, capability-pack contract, runtime loader, and Blueprint emitter.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./capability-index": {
      "types": "./dist/capability-index.d.ts",
      "import": "./dist/capability-index.js"
    },
    "./capability-validate": {
      "types": "./dist/capability-validate.d.ts",
      "import": "./dist/capability-validate.js"
    },
    "./emitter": {
      "types": "./dist/emitter.d.ts",
      "import": "./dist/emitter.js"
    },
    "./gallery": {
      "types": "./dist/gallery.d.ts",
      "import": "./dist/gallery.js"
    },
    "./harness-version": {
      "types": "./dist/harness-version.d.ts",
      "import": "./dist/harness-version.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "render-harness-build": "./dist/bin/build.js",
    "render-harness-capability": "./dist/bin/capability.js",
    "render-harness-deploy": "./dist/bin/deploy.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@render-harness/contracts": "workspace:*",
    "@render-harness/core": "workspace:*",
    "semver": "^7.8.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-agent-harness.git",
    "directory": "packages/registry"
  }
}
