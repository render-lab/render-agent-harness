{
  "name": "@render-harness/ui",
  "version": "0.1.0",
  "description": "Operator control-plane UI for the Render agent harness. Mounts a Hono router at /ui that serves a small React SPA plus the read APIs the SPA needs.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "render-harness",
    "operator-ui",
    "control-plane"
  ],
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsup",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.0",
    "@hono/node-server": "^2.0.2",
    "@render-harness/core": "workspace:*",
    "hono": "^4.12.18",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.7",
    "@vitejs/plugin-react": "^5.1.0",
    "date-fns": "^4.1.0",
    "pretty-ms": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.16.0",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
